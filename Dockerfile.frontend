FROM python:3.14-slim

# Certificados del sistema al día (incidente eMudhra/emSign, oct-2026).
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv con versión FIJA (nunca :latest).
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./

# Instala dependencias incluyendo el grupo opcional 'ui' (Streamlit)
RUN uv sync --frozen --no-dev --extra ui

COPY frontend/ ./frontend/

EXPOSE 8501

# Arranca Streamlit (--server.address 0.0.0.0 requerido para Docker)
CMD ["uv", "run", "--frozen", "streamlit", "run", "frontend/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true"]
